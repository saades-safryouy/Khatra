# Khatra API — copy to .env and fill in (never commit the real .env)
# Server
PORT=5000

# MySQL (TiDB Cloud works too — set DB_SSL=true for TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=khatra
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin user created by `npm run seed` (from env only — no hardcoded password)
ADMIN_EMAIL=admin@khatra.ma
ADMIN_PASSWORD=
# Or provide a bcrypt hash instead of a plain password:
# ADMIN_PASSWORD_HASH=

# CORS — comma-separated frontend origins (leave empty to reflect any origin in dev)
CORS_ORIGIN=http://localhost:5173

# Google reviews (optional — without these, GET /reviews/google returns configured:false)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Translate provider (optional — without one, /translate returns the French text unchanged)
TRANSLATE_API_KEY=

# SMTP for inquiry emails (optional — without these, emailDelivery.configured=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INQUIRY_EMAIL=contact@khatra.ma
